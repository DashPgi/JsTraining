# توکن ربات که از @BotFather گرفتی
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# آیدی گروه مقصد (عدد منفی برای گروه/سوپرگروه، مثال: -1001234567890)
# برای گرفتنش: ربات رو به گروه اضافه کن، یه پیام بفرست، بعد این آدرس رو باز کن:
# https://api.telegram.org/bot<TOKEN>/getUpdates
CHAT_ID=-1001234567890

# یه رشته دلخواه برای امن کردن endpoint کرون (در URL کرون هم همینو ست کن)
CRON_SECRET=change-this-to-something-random

# قالب متن پیام روزانه؛ {date} با تاریخ امروز جایگزین می‌شود
DAILY_MESSAGE_TEMPLATE=📅 آپدیت روزانه - {date}

# اختیاری: تنظیم فونت/رنگ متن روی استیکر از طریق کد قابل تغییره (lib/stickerComposer.js)
